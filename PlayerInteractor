using UnityEngine;
using UnityEngine.InputSystem;
using UnityEngine.UI;
using TMPro;

public class PlayerInteractor : MonoBehaviour
{
  [Header("Interaction Settings")]
  [SerializeField] private float interactDistance = 10f;
  [SerializeField] private float interactSphereRadius = 0.5f;
  [SerializeField] private LayerMask interactLayer;

  [Header("UI")]
  [SerializeField] private TextMeshProUGUI interactionText; // текст нажмите Е
  [SerializeField] private Image crosshair;

  [Header("Crosshair Settings")]
  [SerializeField] private Color normalColor = Color.white;
  [SerializeField] private Color interactableColor = Color.green;
  [SerializeField] private float crosshairSize = 10f;

  private Camera playerCamera;

  void Start()
  {
    if (playerCamera ==null)
    {
        playerCamera = FindObjectOfType<Camera>();
    }
    interactionText.gameObject.SetActive(false);

  }
 void Update()
 {
    Ray ray = new 
    Ray(playerCamera.transform.position, playerCamera.transform.forward);
    RaycastHit hit;

    if (Physics.Raycast(ray, out hit, interactDistance, interactLayer))
    {
        InteractableObject interactable = hit.collider.GetComponent<InteractableObject>();
        if (interactable != null)
        {
            interactionText.text = interactable.GetInteractionText();
            interactionText.gameObject.SetActive(true);
            if (Keyboard.current !=null && Keyboard.current.eKey.wasPressedThisFrame)
            {
                interactable.Interact();
            }
        }
    }
    else 
    {
        interactionText.gameObject.SetActive(false);
    }
    if (playerCamera != null)
    {
        Debug.DrawRay (
            playerCamera.transform.position, playerCamera.transform.forward * interactDistance, Color.green);
    }
 }
}
